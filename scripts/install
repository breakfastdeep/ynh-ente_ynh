#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================
source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SETUP VARIABLES FROM MANIFEST/SETTINGS
#=================================================
app=$app                        # entephotos
domain=$(ynh_app_setting_get --app=$app --key=domain)
path=$(ynh_app_setting_get --app=$app --key=path)
install_dir="/var/www/$app"     # where we put code
data_dir=$(ynh_app_setting_get --app=$app --key=data_dir)
db_name=$(ynh_app_setting_get --app=$app --key=db_name)
db_user=$(ynh_app_setting_get --app=$app --key=db_user)
db_pwd=$(ynh_app_setting_get --app=$app --key=db_pwd)

#=================================================
# INSTALL OS DEPENDENCIES
#=================================================
ynh_script_progression "Installing system packages..."
ynh_install_app_dependencies "git golang-go build-essential pkg-config nodejs npm libsodium-dev"

#=================================================
# PREPARE DIRECTORIES
#=================================================
ynh_script_progression "Preparing directories..."
mkdir -p "$install_dir/server" "$install_dir/web" "$data_dir"
chown -R "$app:www-data" "$install_dir" "$data_dir"

#=================================================
# SETUP DATABASE (MySQL via YunoHost resource)
#=================================================
ynh_script_progression "Database settings loaded: $db_name (user $db_user)"

#=================================================
# INSTALL MUSEUM (Go API SERVER)
#=================================================
ynh_script_progression "Cloning and building Ente museum (API)..."
git clone https://github.com/ente-io/ente.git "$install_dir/server"
cd "$install_dir/server"
go build -o /usr/bin/ente-museum cmd/museum/main.go

# Write museum configuration
cat <<EOF >"$install_dir/server/museum.yaml"
db:
  host: 127.0.0.1
  port: 3306
  name: $db_name
  user: $db_user
  password: $db_pwd
key:
  # Generate or read from settings
  encryption: $(head -c 32 /dev/urandom | base64)
  hash: $(head -c 64 /dev/urandom | base64)
jwt:
  secret: $(head -c 32 /dev/urandom | base64 | tr '+/' '-_')
s3:
  are_local_buckets: true
  # No S3, use local storage under $data_dir
EOF

#=================================================
# INSTALL WEB (Node.js)
#=================================================
ynh_script_progression "Cloning and building Ente web UI..."
git clone https://github.com/ente-io/web.git "$install_dir/web"
cd "$install_dir/web"
npm install --unsafe-perm
npm run build

#=================================================
# SYSTEMD SERVICE FILES
#=================================================
ynh_script_progression "Configuring systemd services..."

# Museum service
ynh_config_add systemd --template="conf/ente-museum.service" --destination="/etc/systemd/system/ente-museum.service"

# Web service
ynh_config_add systemd --template="conf/ente-web.service" --destination="/etc/systemd/system/ente-web.service"

systemctl daemon-reload
systemctl enable ente-museum ente-web
systemctl start ente-museum ente-web

#=================================================
# NGINX CONFIGURATION
#=================================================
ynh_script_progression "Adding Nginx configuration..."
ynh_config_add nginx --template="conf/nginx.conf"

#=================================================
# FINALIZE
#=================================================
ynh_script_progression "Installation complete! Access your app at https://$domain$path"
