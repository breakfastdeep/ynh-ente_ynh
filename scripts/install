#!/bin/bash
source _common.sh

# 1. Bağımlılıklar (Ubuntu/Debian)
ynh_install_app_dependencies "
    postgresql
    golang-go
    libsodium-dev
    pkg-config
    nodejs
    npm
    make
"

# 2. PostgreSQL ayarları
DB_PASSWORD=$(ynh_string_random 32)
ynh_postgresql_create_user "ente_user" "$DB_PASSWORD"
ynh_postgresql_create_db "ente_db" "ente_user"

# 3. Ente kaynak kodları
FINAL_PATH="/opt/ente"
git clone https://github.com/ente-io/ente "$FINAL_PATH"
cd "$FINAL_PATH"
git checkout tags/v0.14.0  # Son kararlı sürüm

# 4. Go bağımlılıkları
cd server
go mod download

# 5. Museum (server) derleme
make build  # Veya: go build -o museum cmd/museum/main.go

# 6. Web arayüzü derleme
cd ../web
npm install
npm run build

# 7. Ortam değişkenleri
cat > "$FINAL_PATH/.env" << EOF
ENTE_DB_USER=ente_user
ENTE_DB_PASSWORD=$DB_PASSWORD
ENTE_DB_NAME=ente_db
ENTE_DB_HOST=localhost
ENTE_ENCRYPTION_KEY=$(ynh_string_random 64)
ENTE_HTTP_PORT=8080
ENTE_DATA_DIR=$FINAL_PATH/data
ENTE_ADMIN_EMAIL=$admin_email
EOF

# 8. Systemd servisi
ynh_add_systemd_config --service="ente-museum" --template="../conf/museum.service"

# 9. Nginx konfigürasyonu
ynh_add_nginx_config --template="../conf/nginx.conf"

# 10. Veri dizini
mkdir -p "$FINAL_PATH/data"
chown -R ente:ente "$FINAL_PATH"

# 11. Admin kullanıcı oluştur
sudo -u ente bash -c "cd $FINAL_PATH/server && ./museum --createadmin --email $admin_email"